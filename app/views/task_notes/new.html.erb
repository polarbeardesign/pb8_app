<% content_for :title, "New task note" %>

<div class="mx-auto md:w-2/3 mb-16 w-full">
  <h1 class="font-bold text-4xl">New task note</h1>

  <% content_for :form_actions do %>
    <%= link_to "Back to task notes", task_notes_path, class: "rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <% end %>

  <%= render "form", task_note: @task_note %>
</div>
