<%= form_with(model: task_note, class: "contents") do |form| %>
  <div class="flex flex-wrap items-center justify-end gap-2 my-5">
    <%= content_for(:form_actions) %>
    <%= form.submit class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>

  <% if task_note.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(task_note.errors.count, "error") %> prohibited this task_note from being saved:</h2>

      <ul class="list-disc ml-6">
        <% task_note.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full dark:bg-slate-800 dark:text-white", {"border-gray-400 focus:outline-blue-600": task_note.errors[:title].none?, "border-red-400 focus:outline-red-600": task_note.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.textarea :description, rows: 8, class: ["block shadow rounded-md border outline-none px-3 py-2 mt-2 w-full dark:bg-slate-800 dark:text-white", {"border-gray-400 focus:outline-blue-600": task_note.errors[:description].none?, "border-red-400 focus:outline-red-600": task_note.errors[:description].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :task_id %>
    <% if params['task_id'].blank? %>
      <%= form.collection_select :task_id, Task.active.sorted.all, :id, :task_detail, options = {:prompt => true}, html_options = {:class => "block shadow-sm rounded-md border border-gray-400 outline-hidden px-3 py-2 mt-2 w-full dark:bg-slate-800 dark:text-white"}   %>
    <% else %>
      <%= form.collection_select :task_id, Task.active.sorted.all, :id, :task_detail, options = {:prompt => true, :selected => params['task_id']}, html_options = {:class => "block shadow-sm rounded-md border border-gray-400 outline-hidden px-3 py-2 mt-2 w-full dark:bg-slate-800 dark:text-white"}   %>
    <% end %>
  </div>
<% end %>
