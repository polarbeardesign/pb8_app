<div class="mx-auto md:w-2/3 mb-16 w-full">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 dark:bg-gray-700 mb-5 text-green-500 dark:text-green-400 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <% if authenticated? %>
      <div class="flex justify-end mb-5 w-full">
        <div class="inline-block ml-2">
          <%= link_to "Edit this page content", edit_page_content_path(@page_content), class: "mt-2 rounded-lg py-2 px-4 bg-sky-200 inline-block font-medium dark:text-zinc-700" %>
        </div>
        <div class="inline-block ml-2">
          <%= link_to "Back to page contents", page_contents_path, class: "mt-2 rounded-lg py-2 px-4 bg-gray-200 inline-block font-medium dark:text-zinc-700" %>
        </div>
        <div class="inline-block ml-2">
          <%= button_to "Destroy this page content", @page_content, method: :delete, class: "cursor-pointer mt-2 rounded-lg py-2 px-4 bg-red-200 font-medium dark:text-zinc-700" %>
        </div>
      </div>
    <% end %>

    <%= render @page_content %>

  </div>
</div>
