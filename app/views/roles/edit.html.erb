<div class="mx-auto md:w-2/3 mb-16 w-full">
  <h1 class="font-bold text-4xl">Editing role</h1>

  <% content_for :form_actions do %>
    <%= link_to "Show this role", @role, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium dark:bg-slate-500" %>
    <%= link_to "Back to roles", roles_path, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium dark:bg-slate-500" %>
  <% end %>

  <%= render "form", role: @role %>
</div>
