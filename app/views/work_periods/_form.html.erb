<%= form_with(model: work_period, class: "contents") do |form| %>
  <div class="flex flex-wrap items-center justify-end gap-2 my-5">
    <%= content_for(:form_actions) %>
    <%= form.submit class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
  </div>

  <% if work_period.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(work_period.errors.count, "error") %> prohibited this work_period from being saved:</h2>

      <ul>
        <% work_period.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :start_time %>
    <%= form.text_field :start_time, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 dark:bg-slate-800 dark:text-white w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :end_time %>
    <%= form.text_field :end_time, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 dark:bg-slate-800 dark:text-white w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :time_note %>
    <%= form.textarea :time_note, rows: 8, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 dark:bg-slate-800 dark:text-white w-full" %>
  </div>

  <div class="my-5">
    <%= form.label :files, "Attachments (PDF or images)" %>
    <%= form.file_field :files, multiple: true, accept: "application/pdf,image/*", class: "block mt-2 w-full text-sm dark:text-white" %>
    <% saved_files = work_period.persisted? ? work_period.files_attachments.select(&:persisted?) : [] %>
    <% if saved_files.any? %>
      <ul class="mt-3 space-y-1 text-sm">
        <% saved_files.each do |file| %>
          <li class="flex items-center gap-2">
            <%= check_box_tag "remove_file_ids[]", file.id, false, id: "remove_file_#{file.id}" %>
            <label for="remove_file_<%= file.id %>">remove</label>
            <%= link_to file.filename.to_s, rails_blob_path(file, disposition: "inline"), target: "_blank", rel: "noopener" %>
            <span class="text-gray-500">(<%= number_to_human_size(file.byte_size) %>)</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <div class="my-5">
    <%= form.label :billable %>
    <%= form.checkbox :billable, class: "block mt-2 h-5 w-5 dark:bg-slate-800 dark:border-slate-600 dark:checked:bg-blue-600 dark:checked:border-slate-600" %>
  </div>

  <div class="my-5">
    <%= form.label :task_id %>
    <%#= form.text_field :task_id, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 dark:bg-slate-800 dark:text-white w-full" %>
    <%= form.collection_select(:task_id, Task.sorted.all, :id, :task_detail, { prompt: true }, { class: ["block shadow-sm rounded-md border outline-hidden px-3 py-2 mt-2 w-full dark:bg-slate-800 dark:text-white", {"border-gray-400 focus:outline-blue-600": work_period.errors[:task_id].none?, "border-red-400 focus:outline-red-600": work_period.errors[:task_id].any?}]} ) %>
  </div>
<% end %>
