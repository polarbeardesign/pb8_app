<% content_for :title, "Priority matrix" %>

<%
  # [key, heading, hint, container colours]
  cells = {
    do:         [ "Do first",  "Important · Urgent",         "bg-red-50 border-red-200 dark:bg-red-900/20 dark:border-red-800" ],
    schedule:   [ "Schedule",  "Important · Not urgent",     "bg-sky-50 border-sky-200 dark:bg-sky-900/20 dark:border-sky-800" ],
    delegate:   [ "Quick wins / delegate", "Not important · Urgent", "bg-amber-50 border-amber-200 dark:bg-amber-900/20 dark:border-amber-800" ],
    eliminate:  [ "Later / drop", "Not important · Not urgent", "bg-gray-50 border-gray-200 dark:bg-slate-800 dark:border-gray-700" ]
  }
%>

<div class="w-full max-w-5xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-2">
    <h1 class="font-bold text-3xl sm:text-4xl">Priority matrix</h1>
    <div class="flex items-center gap-3">
      <%= link_to "List", reminders_path, class: "rounded-md py-2 px-4 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 font-medium" %>
      <%= link_to "New Reminder", new_reminder_path, class: "rounded-md py-2 px-4 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
    </div>
  </div>
  <p class="text-sm text-gray-500 mb-6">
    <%= pluralize(@total, "open reminder") %>. Important = priority <%= Reminder::IMPORTANT_AT %>+.
    Urgent = time critical, overdue or due within <%= Reminder::URGENT_WITHIN_DAYS %> days.
  </p>

  <div class="md:grid md:grid-cols-[1.5rem_1fr_1fr] md:gap-3">
    <%# column labels %>
    <div class="hidden md:block"></div>
    <div class="hidden md:block text-center text-xs font-semibold uppercase tracking-wide text-gray-500">Urgent</div>
    <div class="hidden md:block text-center text-xs font-semibold uppercase tracking-wide text-gray-500">Not urgent</div>

    <% [ [ "Important", %i[do schedule] ], [ "Not important", %i[delegate eliminate] ] ].each do |row_label, keys| %>
      <div class="hidden md:flex items-center justify-center">
        <span class="text-xs font-semibold uppercase tracking-wide text-gray-500 [writing-mode:vertical-rl] rotate-180"><%= row_label %></span>
      </div>
      <% keys.each do |key| %>
        <% title, hint, box = cells[key] %>
        <% items = @quadrants[key] || [] %>
        <section class="rounded-lg border p-3 mb-3 md:mb-0 min-h-48 <%= box %>" id="quadrant_<%= key %>">
          <div class="flex items-start justify-between gap-2 mb-2">
            <div>
              <h2 class="font-bold text-base leading-tight"><%= title %></h2>
              <div class="text-xs text-gray-500"><%= hint %></div>
            </div>
            <span class="text-xs text-gray-500 whitespace-nowrap">Qty: <%= items.size %></span>
          </div>
          <% if items.any? %>
            <ul class="list-none pl-0 space-y-2 max-h-96 overflow-y-auto">
              <% items.each do |r| %>
                <li class="rounded-md bg-white dark:bg-slate-700 border border-gray-200 dark:border-gray-600 px-2.5 py-1.5 text-sm" id="<%= dom_id r, :matrix %>">
                  <div class="flex items-start gap-2">
                    <div class="min-w-0 flex-1">
                      <div class="text-[11px] text-gray-400 truncate"><%= r.task_label %></div>
                      <%= link_to r.title, reminder_path(r), class: "font-medium leading-snug hover:underline break-words" %>
                    </div>
                    <%= render "priority", reminder: r, inline: "matrix" %>
                  </div>
                  <div class="flex flex-wrap gap-x-3 text-[11px] text-gray-500 mt-0.5">
                    <% if r.due %><span class="<%= "text-red-600 font-medium" if r.overdue? %>"><%= r.overdue? ? "Overdue · " : "Due " %><%= r.due.strftime("%b %-d") %></span><% end %>
                    <% if r.time_critical? %><span class="text-red-600 font-medium">Time critical</span><% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-gray-400 py-4 text-center">Nothing here</p>
          <% end %>
        </section>
      <% end %>
    <% end %>
  </div>
</div>
