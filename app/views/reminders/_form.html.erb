<% input = "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 outline-hidden px-3 py-2 mt-2 w-full dark:bg-slate-800 dark:text-white" %>
<%# change_count tracks how many times a reminder has been edited %>
<% new_cc = reminder.change_count.nil? ? 0 : reminder.change_count.to_int + 1 %>
<%= form_with(model: reminder, class: "contents") do |form| %>
  <% if reminder.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(reminder.errors.count, "error") %> prohibited this reminder from being saved:</h2>
      <ul class="list-disc ml-6">
        <% reminder.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :change_count, value: new_cc %>

  <div class="my-5">
    <%= form.label :title %>
    <%= form.text_field :title, class: input %>
  </div>

  <div class="my-5">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, class: input %>
  </div>

  <div class="grid grid-cols-2 gap-4 my-5">
    <div class="col-span-2">
      <%= form.label :task_id, "Task" %>
      <%# New reminders only offer active tasks; an existing reminder keeps its current task even if it has since been deactivated. %>
      <% tasks = Task.active.or(Task.where(id: reminder.task_id)).includes(:customer).sorted %>
      <%= form.select :task_id, tasks.map { |t| [ "#{t.customer.short_name} - #{t.task_name}", t.id ] }, { include_blank: "— select —" }, class: input %>
    </div>
    <div>
      <%= form.label :due, "Due date (optional)" %>
      <%= form.date_field :due, class: input %>
    </div>
    <div>
      <%= form.label :reminder_date, "Remind on (optional)" %>
      <%= form.date_field :reminder_date, class: input %>
    </div>
    <div>
      <%= form.label :importance, "Priority (1–10)" %>
      <%= form.select :importance, (1..10).to_a.reverse, {}, class: input %>
    </div>
    <div>
      <%= form.label :estimate_hours, "Time estimate in hours (optional)" %>
      <%= form.number_field :estimate_hours, step: 0.25, min: 0, class: input %>
    </div>
    <div>
      <%= form.label :recurrence, "Repeats" %>
      <%= form.select :recurrence, Reminder::RECURRENCES.map { |r| [ r.capitalize, r ] }, { include_blank: "Never" }, class: input %>
    </div>
    <div class="flex flex-col gap-2 justify-center mt-6">
      <span class="flex items-center gap-2">
        <%= form.check_box :time_critical, class: "rounded border-gray-400" %>
        <%= form.label :time_critical, "Time critical" %>
      </span>
      <span class="flex items-center gap-2">
        <%= form.check_box :completed, class: "rounded border-gray-400" %>
        <%= form.label :completed, "Complete" %>
      </span>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <%= form.submit class: "rounded-md py-3 px-5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    <%= content_for(:form_actions) %>
  </div>
<% end %>
