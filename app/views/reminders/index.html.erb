<% content_for :title, "Reminders" %>

<div class="w-full max-w-4xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Reminders</h1>
    <%= link_to "New reminder", new_reminder_path, class: "rounded-md py-3 px-5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @open_reminders.any? %>
    <ul class="space-y-3 list-none">
      <% @open_reminders.each do |reminder| %>
        <% badge = reminder.importance >= 8 ? "bg-red-100 text-red-700" : (reminder.importance >= 5 ? "bg-amber-100 text-amber-700" : "bg-gray-100 text-gray-600") %>
        <li id="<%= dom_id reminder %>" class="rounded-lg border border-gray-200 dark:border-gray-700 p-3 <%= "border-l-4 border-l-red-500" if reminder.overdue? %>">
          <div class="flex items-start gap-3">
            <div class="pt-0.5"><%= render "toggle", reminder: reminder %></div>
            <div class="min-w-0 flex-1">
              <%= link_to reminder.title, reminder_path(reminder), class: "font-medium text-base leading-snug hover:underline break-words" %>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 mt-1 text-xs">
                <% if reminder.due %>
                  <span class="<%= reminder.overdue? ? "text-red-600 font-medium" : "text-gray-500" %>">
                    <%= reminder.overdue? ? "Overdue · " : "Due " %><%= reminder.due.strftime("%b %-d") %>
                  </span>
                <% end %>
                <% if reminder.time_critical? %>
                  <span class="text-red-600 font-medium">Time critical</span>
                <% end %>
                <span class="text-gray-400 truncate"><%= reminder.task_label %></span>
              </div>
            </div>
            <%# The badge is a select: tap it, pick a value, it saves and the list re-sorts. %>
            <%= form_with model: reminder, data: { controller: "autosubmit" }, class: "shrink-0" do |form| %>
              <%= hidden_field_tag :inline, 1 %>
              <%= form.select :importance, (1..10).to_a.reverse, {},
                    title: "Change priority", "aria-label": "Priority",
                    data: { action: "change->autosubmit#submit" },
                    class: "appearance-none bg-none rounded-full px-2.5 py-0.5 text-xs font-semibold cursor-pointer border-0 text-center [text-align-last:center] #{badge}" %>
            <% end %>
          </div>
          <div class="flex items-center justify-end gap-4 mt-3">
            <%= link_to "Edit", edit_reminder_path(reminder), class: "text-sm text-blue-600 hover:underline" %>
            <%= render "start", reminder: reminder, active: @active_task_ids.include?(reminder.task_id) %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center my-10">Nothing to do. 🎉</p>
  <% end %>

  <% if @done_reminders.any? %>
    <h2 class="text-lg font-bold pb-1 mb-3 mt-10 border-b border-gray-200 dark:border-gray-700">Recently completed</h2>
    <ul class="text-sm space-y-1 list-none">
      <% @done_reminders.each do |reminder| %>
        <li class="flex items-center gap-2 text-gray-500">
          <%= render "toggle", reminder: reminder %>
          <%= link_to reminder.title, reminder_path(reminder), class: "hover:underline line-through" %>
          <span class="text-xs"><%= reminder.updated_at.strftime("%b %-d") %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
