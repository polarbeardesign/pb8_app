<% content_for :title, @reminder.title %>

<div class="w-full max-w-2xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 dark:bg-gray-700 mb-5 text-green-500 dark:text-green-400 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-start gap-4 mb-6">
    <h1 class="font-bold text-4xl break-words min-w-0 <%= "line-through text-gray-500" if @reminder.completed? %>"><%= @reminder.title %></h1>
    <div class="flex gap-2 shrink-0">
      <%= link_to "Edit", edit_reminder_path(@reminder), class: "rounded-md py-3 px-5 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 font-medium" %>
      <%= link_to "Back", reminders_path, class: "rounded-md py-3 px-5 bg-gray-100 hover:bg-gray-200 dark:bg-slate-700 dark:hover:bg-slate-600 font-medium" %>
    </div>
  </div>

  <% unless @reminder.completed? %>
    <div class="flex justify-center my-5">
      <%= render "start", reminder: @reminder, active: @active_task_ids.include?(@reminder.task_id), size: :large %>
    </div>
  <% end %>

  <dl class="grid grid-cols-2 gap-x-8 gap-y-4 text-sm">
    <div>
      <dt class="text-gray-500">Task</dt>
      <dd class="font-medium mt-0.5"><%= link_to @reminder.task_label, task_path(@reminder.task), class: "hover:underline" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Priority</dt>
      <dd class="font-medium mt-0.5"><%= @reminder.importance %> / 10<%= " · Time critical" if @reminder.time_critical? %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Due</dt>
      <dd class="font-medium mt-0.5 <%= "text-red-600" if @reminder.overdue? %>"><%= @reminder.due&.strftime("%B %-d, %Y") || "—" %><%= " (overdue)" if @reminder.overdue? %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Reminder date</dt>
      <dd class="font-medium mt-0.5"><%= @reminder.reminder_date&.strftime("%B %-d, %Y") || "—" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Status</dt>
      <dd class="font-medium mt-0.5"><%= @reminder.completed? ? "Completed #{@reminder.updated_at.strftime("%b %-d, %Y")}" : "Open" %></dd>
    </div>
    <% if @reminder.description.present? %>
      <div class="col-span-2">
        <dt class="text-gray-500">Description</dt>
        <dd class="mt-0.5"><%= markdown(@reminder.description) %></dd>
      </div>
    <% end %>
  </dl>

  <div class="mt-8">
    <%= link_to "Delete", reminder_path(@reminder), data: { turbo_method: :delete, turbo_confirm: "Delete this reminder?" }, class: "text-red-600 hover:underline text-sm" %>
  </div>
</div>
