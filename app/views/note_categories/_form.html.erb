<%= form_with(model: note_category, class: "contents") do |form| %>
  <div class="flex flex-wrap items-center justify-end gap-2 my-5">
    <%= content_for(:form_actions) %>
    <%= form.submit class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
  </div>

  <% if note_category.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-lg mt-3">
      <h2><%= pluralize(note_category.errors.count, "error") %> prohibited this note_category from being saved:</h2>

      <ul>
        <% note_category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :category_name %>
    <%= form.text_field :category_name, class: "block shadow rounded-md border border-gray-400 outline-none px-3 py-2 mt-2 dark:bg-slate-800 dark:text-white w-full" %>
  </div>
<% end %>
