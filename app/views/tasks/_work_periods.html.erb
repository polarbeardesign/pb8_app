<% work_periods = @task.work_periods.time_desc.to_a %>
<% hours_for = {} %>
<% total_hours = 0 %>
<% total_bill_hours = 0 %>
<% work_periods.each do |work_period| %>
  <% if work_period.start_time != work_period.end_time %>
    <% hours = ((work_period.end_time - work_period.start_time) / 3600).round(2) %>
    <% hours_for[work_period.id] = hours %>
    <% total_hours = total_hours + hours %>
    <% total_bill_hours = total_bill_hours + hours if work_period.billable == true %>
  <% end %>
<% end %>

<%# Desktop: table %>
<div class="relative overflow-x-auto hidden md:block">
<table class="border-collapse table-fixed w-full">
  <thead class="text-xs text-white  bg-[#1e6da6] dark:bg-gray-700 dark:text-gray-400">
  <tr>
    <th scope="col" class="w-44">Date:</th>
    <th scope="col" class="w-16">Hours:</th>
    <th scope="col" class="w-16">Billable:</th>
    <th scope="col" >Notes:</th>
  </tr>
 </thead>
<tbody>
<% work_periods.each do |work_period| %>
  <% hours = hours_for[work_period.id] %>
  <tr class="odd:bg-white odd:dark:bg-gray-900 even:bg-[#f2f7fa] even:dark:bg-gray-800 border-b dark:border-gray-700 border-gray-200 border-2">
    <td scope="row" class="whitespace-nowrap">
      <%= link_to work_period.end_time.strftime("%a - %b %d, %y"), edit_work_period_path(work_period) %>
      <div><%= work_period.start_time.strftime("%H:%M") %> ~ <%= work_period.end_time.strftime("%H:%M") %></div>
    </td>
    <td class="text-right"><%= hours %></td>
    <td class="text-right"><% if work_period.billable == true %><%= hours %><% end %></td>
    <td><% if work_period.end_time != work_period.start_time %><%= markdown(work_period.time_note) %><% end %></td>
  </tr>
<% end %>
  <tr>
    <td><b>Total Time:</b></td>
    <td><b>
      <% if total_hours > 0 %>
        <%= total_hours.round(2) %>
      <% else %>
        0
      <% end %></b></td>
    <td align="right"><b><%= total_bill_hours.round(2) %></b></td>
    <td>&nbsp;</td>
  </tr>
</tbody>
</table>
</div>

<%# Mobile: cards %>
<div class="md:hidden">
  <div class="flex justify-between items-center rounded-lg px-4 py-3 mb-3 text-white bg-[#1e6da6] dark:bg-gray-700 dark:text-gray-300">
    <span class="font-bold">Total Time</span>
    <span class="text-sm">
      <b><%= total_hours > 0 ? total_hours.round(2) : 0 %></b> hrs
      &middot;
      <b><%= total_bill_hours.round(2) %></b> billable
    </span>
  </div>

  <% work_periods.each do |work_period| %>
    <% hours = hours_for[work_period.id] %>
    <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 mb-3">
      <div class="flex justify-between items-start gap-3">
        <div>
          <%= link_to work_period.end_time.strftime("%a - %b %d, %y"), edit_work_period_path(work_period), class: "font-medium" %>
          <div class="text-sm text-gray-500 dark:text-gray-400"><%= work_period.start_time.strftime("%H:%M") %> ~ <%= work_period.end_time.strftime("%H:%M") %></div>
        </div>
        <div class="flex gap-2 shrink-0">
          <% if hours %>
            <span class="rounded-full px-2 py-0.5 text-xs font-medium bg-sky-100 text-sky-800 dark:bg-sky-900 dark:text-sky-200"><%= hours %> hrs</span>
          <% end %>
          <% if work_period.billable == true && hours %>
            <span class="rounded-full px-2 py-0.5 text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">billable</span>
          <% end %>
        </div>
      </div>
      <% if work_period.end_time != work_period.start_time && work_period.time_note.present? %>
        <div class="mt-2 pt-2 border-t border-gray-100 dark:border-gray-800 break-words"><%= markdown(work_period.time_note) %></div>
      <% end %>
    </div>
  <% end %>
</div>
